{
  "$schema": "https://hearthscale.com/app.schema.json",
  "id": "music-studio",
  "name": "Music studio",
  "version": "0.1.0",
  "api": 6,
  "description": "Make songs from a few words, then mix them on tracks.",
  "icon": {
    "light": "assets/icon-light.svg",
    "dark": "assets/icon-dark.svg"
  },
  "license": "MIT",
  "categories": [
    "audio"
  ],
  "payment": "free",
  "environment": {
    "kind": "process"
  },
  "permissions": [
    "microphone"
  ],
  "uses": [
    "db",
    "jobs",
    "models",
    "roots",
    "sessions",
    "events"
  ],
  "models": {
    "music": {
      "required": true
    },
    "separation": {
      "required": false
    },
    "chat": {
      "required": false
    }
  },
  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "versions": {
          "type": "integer",
          "title": "Takes to choose from",
          "description": "Each new piece or change comes as this many takes, and you keep the one you like. Each take adds to the wait.",
          "minimum": 1,
          "maximum": 4,
          "default": 1
        }
      }
    }
  },
  "agent": {
    "name": "Music studio",
    "model": {
      "kind": "chat",
      "tools": true
    },
    "prompt": [
      "prompt/system.md"
    ],
    "tools": [
      "make_music",
      "change_clip",
      "split_clip",
      "set_song",
      "mix_track",
      "ask"
    ]
  },
  "tools": [
    {
      "name": "forget_audio",
      "title": "Delete audio",
      "description": "Deletes audio the app no longer uses.",
      "input": {
        "type": "object",
        "properties": {
          "assets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the audio assets to delete."
          }
        },
        "required": [
          "assets"
        ]
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "export_parts",
      "title": "Export tracks",
      "description": "Saves audio files into a folder the person gave the app, then deletes the app's copies.",
      "input": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "The handle of the folder's mount."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "asset": {
                  "type": "string",
                  "description": "The id of the audio asset."
                },
                "name": {
                  "type": "string",
                  "description": "The file name in the folder."
                }
              },
              "required": [
                "asset",
                "name"
              ]
            }
          }
        },
        "required": [
          "root",
          "files"
        ]
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "make_music",
      "title": "Make music",
      "icon": "music",
      "description": "Makes a new piece of music from words and puts it on a new track of the open song, at the playhead.",
      "input": {
        "type": "object",
        "properties": {
          "song": {
            "type": "string",
            "description": "The id of the open song."
          },
          "words": {
            "type": "string",
            "description": "What the music is: genre, mood, instruments."
          },
          "seconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 300,
            "description": "How long it may run."
          }
        },
        "required": [
          "song",
          "words"
        ]
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "model"
      ]
    },
    {
      "name": "change_clip",
      "title": "Change a clip",
      "icon": "music",
      "description": "Changes one clip of the open song with the music model: \"style\" makes it again in a new style, \"redo\" makes the bars from_bar to to_bar again, \"longer\" adds seconds at its end, \"part\" adds an instrument part on a new track. The result plays as a new version of the clip.",
      "input": {
        "type": "object",
        "properties": {
          "song": {
            "type": "string",
            "description": "The id of the open song."
          },
          "clip": {
            "type": "string",
            "description": "The id of the clip."
          },
          "how": {
            "type": "string",
            "enum": [
              "style",
              "redo",
              "longer",
              "part"
            ]
          },
          "words": {
            "type": "string",
            "description": "What the music becomes."
          },
          "change": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "For style: how different, 0 close to 1 far."
          },
          "from_bar": {
            "type": "integer",
            "minimum": 1,
            "description": "For redo: the first bar."
          },
          "to_bar": {
            "type": "integer",
            "minimum": 1,
            "description": "For redo: the last bar."
          },
          "seconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 120,
            "description": "For longer: seconds to add."
          },
          "part": {
            "type": "string",
            "enum": [
              "drums",
              "bass",
              "guitar",
              "keyboard",
              "strings",
              "synth",
              "percussion",
              "brass",
              "woodwinds",
              "vocals"
            ],
            "description": "For part: the instrument."
          }
        },
        "required": [
          "song",
          "clip",
          "how",
          "words"
        ]
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "model"
      ]
    },
    {
      "name": "split_clip",
      "title": "Split into stems",
      "icon": "music",
      "description": "Splits a clip of the open song into its parts, such as vocals, drums and bass, each on a track of its own.",
      "input": {
        "type": "object",
        "properties": {
          "song": {
            "type": "string",
            "description": "The id of the open song."
          },
          "clip": {
            "type": "string",
            "description": "The id of the clip."
          }
        },
        "required": [
          "song",
          "clip"
        ]
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "model"
      ]
    },
    {
      "name": "set_song",
      "title": "Set tempo and key",
      "icon": "music",
      "description": "Sets the tempo or the key of the open song.",
      "input": {
        "type": "object",
        "properties": {
          "song": {
            "type": "string",
            "description": "The id of the open song."
          },
          "tempo": {
            "type": "integer",
            "minimum": 40,
            "maximum": 240,
            "description": "Beats a minute."
          },
          "key": {
            "type": "string",
            "description": "Such as \"A minor\" or \"C major\"."
          }
        },
        "required": [
          "song"
        ]
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "model"
      ]
    },
    {
      "name": "mix_track",
      "title": "Mix a track",
      "icon": "music",
      "description": "Sets the volume, pan, mute, solo or sound of a track of the open song.",
      "input": {
        "type": "object",
        "properties": {
          "song": {
            "type": "string",
            "description": "The id of the open song."
          },
          "track": {
            "type": "string",
            "description": "The id of the track."
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.5,
            "description": "1 is as it came."
          },
          "pan": {
            "type": "number",
            "minimum": -1,
            "maximum": 1,
            "description": "-1 left, 0 centre, 1 right."
          },
          "muted": {
            "type": "boolean"
          },
          "solo": {
            "type": "boolean"
          },
          "sound": {
            "type": "string",
            "enum": [
              "none",
              "warm",
              "bright",
              "space"
            ]
          }
        },
        "required": [
          "song",
          "track"
        ]
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "model"
      ]
    }
  ],
  "surfaces": [
    {
      "id": "studio",
      "kind": "view",
      "title": "Music studio",
      "entry": "views/studio.js",
      "placements": [
        "rail",
        "tab"
      ],
      "opens": [
        ".wav",
        ".mp3",
        ".flac",
        ".ogg",
        ".m4a"
      ]
    }
  ],
  "onboarding": {
    "version": 2,
    "cards": [
      {
        "title": "Songs from a few words.",
        "image": "assets/intro-studio.webp",
        "text": "Describe a song, and Music studio makes it.",
        "download": "audio-cpp/stable-audio-3-small-music"
      },
      {
        "title": "Shape every part.",
        "rows": [
          {
            "icon": "music",
            "title": "Make a song",
            "text": "Describe it, pick a style and choose Make."
          },
          {
            "icon": "pen",
            "title": "Change a part",
            "text": "Change its style, redo some bars, extend it or add an instrument."
          },
          {
            "icon": "view",
            "title": "Split into stems",
            "text": "Put the vocals, drums, bass and the rest on tracks of their own."
          }
        ]
      },
      {
        "title": "Mix it on tracks.",
        "rows": [
          {
            "icon": "speech",
            "title": "Mixer",
            "text": "Set each track's volume, mute it with M or hear it alone with S."
          },
          {
            "icon": "scroll",
            "title": "Snippets",
            "text": "Save a clip, then drop it into any song in time and in tune."
          },
          {
            "icon": "agent",
            "title": "Ask",
            "text": "Say what to change, and it changes the song."
          }
        ]
      },
      {
        "title": "Music that fits.",
        "rows": [
          {
            "icon": "camera",
            "title": "Video soundtracks",
            "text": "Calm piano under a holiday film."
          },
          {
            "icon": "clock",
            "title": "Podcast intros",
            "text": "Ten seconds of upbeat jazz."
          },
          {
            "icon": "lightbulb",
            "title": "Study loops",
            "text": "Lo-fi beats that play as long as you need."
          }
        ]
      }
    ]
  }
}
